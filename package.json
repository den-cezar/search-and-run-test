{
  "name": "search-and-run-browser-extension",
  "version": "0.2.1",
  "description": "Browser extension to search a test name and dispatch its GitHub Actions workflow.",
  "type": "module",
  "license": "MIT",
  "author": "Denys Zatkhei",
  "homepage": "https://github.com/den-cezar/search-and-run-test#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/den-cezar/search-and-run-test.git"
  },
  "bugs": {
    "url": "https://github.com/den-cezar/search-and-run-test/issues"
  },
  "keywords": [
    "browser-extension",
    "manifest-v3",
    "chrome",
    "edge",
    "github-actions",
    "pytest",
    "jira",
    "confluence"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=80 \"tests/**/*.test.js\"",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:edge": "playwright test --project=edge",
    "e2e:headed": "playwright test --headed",
    "package": "node scripts/build-package.mjs chromium",
    "package:firefox": "node scripts/build-package.mjs firefox",
    "firefox:build": "npm run package:firefox && web-ext build --source-dir build/firefox --overwrite-dest",
    "firefox:run": "npm run package:firefox && web-ext run --source-dir build/firefox",
    "firefox:lint": "npm run package:firefox && web-ext lint --source-dir build/firefox --self-hosted",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "web-ext": "^8.10.0"
  }
}
